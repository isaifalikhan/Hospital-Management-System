PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=8h
# Origin allowed to call this API cross-origin. Only needed if the frontend
# is hosted on a different origin than this server (default covers local dev).
CORS_ORIGIN=http://localhost:5173

# Leave unset for local/LAN use (falls back to a SQLite file in backend/data).
# Set this on Vercel to the Postgres connection string it gives you when you
# add Vercel Postgres to the project — switches the app to that DB instead.
# DATABASE_URL=

# Optional. Leave unset (the default) and "Generate Summary" on discharge
# notes / medical record notes uses a built-in template — no API key needed,
# fully functional out of the box. Set this to an Anthropic API key to have
# those drafts generated by Claude instead.
# AI_API_KEY=
# AI_API_URL=https://api.anthropic.com/v1/messages
# AI_MODEL=claude-3-5-haiku-latest
